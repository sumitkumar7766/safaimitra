{
  "expo": {
    "name": "Safaimitra",
    "slug": "safaimitra-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logoapp.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logoapp.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.safaimitraapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logoapp.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.safaimitraapp"
    },
    "web": {
      "favicon": "./assets/logoapp.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-audio",
      "expo-video"
    ]
  }
}
